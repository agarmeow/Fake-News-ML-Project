# Groq API configuration for LLM-based reasoning and arbitration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAKETYPE_MODEL=llama-3.3-70b-versatile
GROQ_FAKETYPE_MODEL_2=llama-3.1-8b-instant

# Fake-type classification pipeline & model directories
FAKETYPE_MODEL_DIR=models/faketype_en_continued
FAKETYPE_PIPELINE=v1

# Cache and performance flags
CACHE_DISABLE=0
FC_TIMING=0

# Hugging Face offline mode (set to 1 to run completely offline from local cache)
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
